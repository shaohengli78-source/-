# 复制前请生成随机值，切勿使用这些占位文本上线
SECRET_KEY=replace-with-64-random-hex-characters
DATABASE_PATH=/data/locker.sqlite3
COOKIE_SECURE=1
STUDENT_ID_PATTERN=[0-9]{8,12}
# 外部学号上报令牌，与设备控制令牌严格分开
INGEST_TOKEN=
DEVICE_TOKEN=
# 只接受 werkzeug generate_password_hash 输出，用于首次创建管理员
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_HASH=
# 必须与部署网址一致；二维码不使用不可信 Host 请求头
PUBLIC_BASE_URL=https://locker-admin-production.up.railway.app
